/ {
	chosen {
		zephyr,canbus = &fdcan2;
	};

	gpio_inputs {
		compatible = "gpio-keys";
		debug1: debug_1 {
			gpios = <&gpiob 58 GPIO_ACTIVE_LOW>;
			label = "DEBUG1";
		};
		debug2: debug_2 {
			gpios = <&gpiob 57 GPIO_ACTIVE_LOW>;
			label = "DEBUG2";
		};
		debug3: debug_3 {
			gpios = <&gpiod 55 GPIO_ACTIVE_LOW>;
			label = "DEBUG3";
		};
	};

	gpio_outputs {
		compatible = "gpio-leds";
		debug0: debug_0 {
			gpios = <&gpiob 62 GPIO_ACTIVE_LOW>;
			label = "DEBUG0";
		};
	};
};

&adc1 {
	pinctrl-0 = <&adc1_in1_pa0>; /* PHA_ISNS */
	pinctrl-names = "default";
	st,adc-clock-source = <SYNC>;
	st,adc-prescaler = <4>;
	status = "okay";
};

&adc2 {
	pinctrl-0 = <&adc1_in2_pa1>; /* PHB_ISNS */
	pinctrl-names = "default";
	st,adc-clock-source = <SYNC>;
	st,adc-prescaler = <4>;
	status = "okay";
};

&adc3 {
	pinctrl-0 = <&adc3_in1_pb1>; /* PHC_ISNS */
	pinctrl-names = "default";
	st,adc-clock-source = <SYNC>;
	st,adc-prescaler = <4>;
	status = "okay";
};

/* adc4 is already configured correctly */

&adc5 {
	pinctrl-0 = <&adc5_in1_pa8 &adc5_in2_pa9>; /* THERM_A and THERM_B */
	pinctrl-names = "default";
	st,adc-clock-source = <SYNC>;
	st,adc-prescaler = <4>;
	status = "okay";
};

&dac1 {
	pinctrl-0 = <&dac1_out1_pa4 &dac1_out2_pa5>; /* SCOPE0 and SCOPE1 */
	pinctrl-names = "default";
	status = "okay";
};

&dac2 {
	pinctrl-0 = <&dac2_out1_pa6>; /* SCOPE2 */
	pinctrl-names = "default";
	status = "okay";
};

&dac3 {
	status = "disabled";
};

&dac4 {
	status = "disabled";
};

&fdcan1 {
	status = "disabled";
};

&fdcan2 {
	pinctrl-0 = <&fdcan2_rx_pb12 &fdcan2_tx_pb13>;
	pinctrl-names = "default";
	status = "okay";
};

&fdcan3 {
	status = "disabled";
};

&i2c1 {
	status = "disabled";
};

&i2c2 {
	status = "disabled";
};

&i2c3 {
	status = "disabled";
};

/* lpuart1 is already configured correctly */

&spi1 {
	status = "disabled";
};

&spi2 {
	status = "disabled"; /* default pins used by fdcan2 */
};

/* spi3 is already configured correctly */

&uart4 {
	status = "disabled";
};

&uart5 {
	status = "disabled";
};

&usart1 {
	status = "disabled";
};

&usart2 {
	status = "disabled";
};

&usart3 {
	status = "disabled";
};
