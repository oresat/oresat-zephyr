/*
RW 7.2 device tree

As of Nov 2024, Zephyr does not support HRTIM (High-Resolution Timers) for PWM.
So all HRTIM pins are configured via src/cube/hrtim.* (Generate CubeMX code).
Pins this includes:
- PC6: PHC_H
- PC7: PHC_L
- PC8: PHB_H
- PC9: PHB_L
- PA10: PHA_H
- PA11: PHA_L
*/

/dts-v1/;
#include <st/g4/stm32g474Xe.dtsi>
#include <st/g4/stm32g474r(b-c-e)tx-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "OreSat Reaction Wheel STM32G474RE board";
	compatible = "oresat,reaction_wheel";

	chosen {
		zephyr,console = &lpuart1;
		zephyr,shell-uart = &lpuart1;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,canbus = &fdcan2;
		zephyr,code-partition = &slot0_partition;
	};

	zephyr,user {
		io-channels = <&adc1 1>, <&adc1 2>, <&adc3 1>, <&adc5 1>, <&adc5 2>;
		io-channel-names = "PHA_ISNS", "PHB_ISNS", "PHC_ISNS", "THERM_A", "THERM_B";
	};

	gpio_inputs {
		compatible = "gpio-keys";
		debug1: debug_1 {
			gpios = <&gpiob 58 GPIO_ACTIVE_LOW>;
			label = "DEBUG1";
		};
		debug2: debug_2 {
			gpios = <&gpiob 57 GPIO_ACTIVE_LOW>;
			label = "DEBUG2";
		};
		debug3: debug_3 {
			gpios = <&gpiod 55 GPIO_ACTIVE_LOW>;
			label = "DEBUG3";
		};
	};

	gpio_outputs {
		compatible = "gpio-leds";
		debug0: debug_0 {
			gpios = <&gpiob 62 GPIO_ACTIVE_LOW>;
			label = "DEBUG0";
		};
	};

	aliases {
		watchdog0 = &iwdg;
		die-temp0 = &die_temp;
		volt-sensor0 = &vref;
		volt-sensor1 = &vbat;
	};
};

&adc1 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	st,adc-clock-source = <SYNC>;
	st,adc-prescaler = <4>;

	channel@1 { /* PHA_ISNS */
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	channel@2 { /* PHB_ISNS */
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

&adc2 {
	status = "disabled";
};

&adc3 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	st,adc-clock-source = <SYNC>;
	st,adc-prescaler = <4>;

	channel@1 { /* PHC_ISNS */
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

&adc4 {
	status = "disabled";
};

&adc5 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	st,adc-clock-source = <SYNC>;
	st,adc-prescaler = <4>;

	channel@1 { /* THERM_A */
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	channel@2 { /* THERM_B */
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(24)>;
	status = "okay";
};

&clk_hsi48 {
	status = "okay";
};

&clk_lsi {
	status = "okay";
};

&dac1 {
	pinctrl-0 = <&dac1_out1_pa4 &dac1_out2_pa5>; /* SCOPE0 and SCOPE1 */
	pinctrl-names = "default";
	status = "okay";
};

&dac2 {
	pinctrl-0 = <&dac2_out1_pa6>; /* SCOPE2 */
	pinctrl-names = "default";
	status = "okay";
};

&dac3 {
	status = "disabled";
};

&dac4 {
	status = "disabled";
};

&die_temp {
	status = "okay";
};

&fdcan1 {
	status = "disabled";
};

&fdcan2 {
	pinctrl-0 = <&fdcan2_rx_pb12 &fdcan2_tx_pb13>;
	pinctrl-names = "default";
	status = "okay";
};

&fdcan3 {
	status = "disabled";
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(34)>;
		};
		slot0_partition: partition@8800 {
			label = "image-0";
			reg = <0x00008800 DT_SIZE_K(240)>;
		};
		slot1_partition: partition@44800 {
			label = "image-1";
			reg = <0x00044800 DT_SIZE_K(234)>;
		};
		/* Set 4Kb of storage at the end of the 512Kb of flash */
		storage_partition: partition@7f000 {
			label = "storage";
			reg = <0x0007f000 DT_SIZE_K(4)>;
		};
	};
};

&i2c1 {
	status = "disabled";
};

&i2c2 {
	status = "disabled";
};

&i2c3 {
	status = "disabled";
};

&iwdg {
	status = "okay";
};

stm32_lp_tick_source: &lptim1 {
	clocks = <&rcc STM32_CLOCK_BUS_APB1 0x80000000>,
		<&rcc STM32_SRC_LSI LPTIM1_SEL(1)>;
	status = "okay";
};

&lpuart1 {
	pinctrl-0 = <&lpuart1_tx_pa2 &lpuart1_rx_pa3>;
	pinctrl-1 = <&analog_pa2 &analog_pa3>;
	pinctrl-names = "default", "sleep";
	current-speed = <115200>;
	status = "okay";
};

&pll {
	div-m = <6>;
	mul-n = <85>;
	div-p = <7>;
	div-q = <2>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(170)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
	apb2-prescaler = <1>;
};

&rng {
	status = "okay";
};

&rtc {
	clocks = <&rcc STM32_CLOCK_BUS_APB1 0x00000400>,
		 <&rcc STM32_SRC_LSI RTC_SEL(2)>;
	status = "okay";
};

&spi1 {
	status = "disabled";
};

&spi2 {
	status = "disabled"; /* default pins used by fdcan2 */
};

&spi3 {
	pinctrl-0 = <&spi3_nss_pa15 &spi3_sck_pc10 &spi3_miso_pc11 &spi3_mosi_pc12>;
	pinctrl-names = "default";
	status = "okay";
};

&uart4 {
	status = "disabled";
};

&uart5 {
	status = "disabled";
};

&usart1 {
	status = "disabled";
};

&usart2 {
	status = "disabled";
};

&usart3 {
	status = "disabled";
};

&vbat {
	status = "okay";
};

&vref {
	status = "okay";
};
